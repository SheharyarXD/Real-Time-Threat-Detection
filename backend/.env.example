# Copy to .env, supply your own values, and never commit the populated file.
SENTINEL_ENVIRONMENT=development
SENTINEL_DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
SENTINEL_SESSION_SECRET=GENERATE_A_RANDOM_VALUE_WITH_AT_LEAST_32_CHARACTERS
SENTINEL_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
SENTINEL_ALLOWED_HOSTS=["127.0.0.1","localhost"]

# Optional Docker Compose development database. Set these before docker compose up.
POSTGRES_USER=sentinel_local
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_LOCAL_PASSWORD
POSTGRES_DB=sentinel
POSTGRES_PORT=5432
